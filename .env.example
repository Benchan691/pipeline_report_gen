# eDrive credentials (copy to .env and fill in)
EDRIVE_USERNAME=your_username
EDRIVE_PASSWORD=your_password

# Remote eDrive folder path (parent destination for each run subfolder)
EDRIVE_REMOTE_PATH=Ben Chan/weekly-reports

# eDrive server URL (required)
EDRIVE_BASE_URL=https://edrive.citictel-cpc.com

# Firecrawl API key(s) (required when search_provider is firecrawl or SearXNG fallback is enabled)
# Comma-separated keys rotate on failure after firecrawl_retry_wait seconds
FIRECRAWL_API_KEY=fc-your-api-key,fc-another-api-key

# Email notification recipients (comma-separated; title/body are configured in config.json)
EMAIL_RECEIVER=you@example.com,other@example.com

# Zimbra SOAP (transfer bridge + report notification emails)
ZIMBRA_HOST=zmailbox.citictel-cpc.com
ZIMBRA_EMAIL=
ZIMBRA_PASSWORD=

# CloudAMQP (transfer wake-up listener; required for --receive-transfer)
CLOUDAMQP_URL=amqps://user:password@host/vhost
CLOUDAMQP_QUEUE=pipeline_transfer
